# ── 필수 ──────────────────────────────────────────────────────
# https://api.slack.com/apps → 앱 선택 → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-여기에-봇-토큰

# ── 내 계정으로 발송 기능 (선택) ──────────────────────────────
# https://api.slack.com/apps → 앱 선택 → Basic Information → App Credentials
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Railway 배포 후 실제 URL로 교체. 로컬 테스트 시: http://localhost:3000/slack/oauth_redirect
SLACK_REDIRECT_URI=https://YOUR-APP.railway.app/slack/oauth_redirect

# ── 서버 설정 (선택) ──────────────────────────────────────────
PORT=3000
TZ=Asia/Seoul
